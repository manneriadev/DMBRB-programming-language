module math 
begin
    struct Point 
    begin
        x: int32
        y: int32
        function translate(dx: int32, dy: int32)::void
        begin
            self.x = self.x + dx
            self.y = self.y + dy
            return
        end
        function get_x()::int32
        begin
            return self.x
        end
    end

    function sum(a: int32, b: int32)::int32 
    begin
        return a + b
    end

    function fact(n: int32)::int32 
    begin
        var result: int32 = 1
        var i: int32 = 1
        while i <= n 
        begin
            result = result * i
            i = i + 1
        end
        return result
    end

    function max(a: int32, b: int32)::int32
    begin
        return a > b ? a : b
    end

    function abs_val(x: int32)::int32
    begin
        return x < 0 ? -x : x
    end
end

var x: int32 = 10
var y: int32 = 20
var global_ptr: int32* = none

function swap(a: int32*, b: int32*)::void
begin
    var tmp: int32 = *a
    *a = *b
    *b = tmp
    return
end

function sum_array(arr: [int32; 5], n: int32)::int32
begin
    var result: int32 = 0
    var i: int32 = 0
    while i < n
    begin
        result = result + arr[i]
        i = i + 1
    end
    return result
end

function main()::int32 
begin
    # базовые переменные
    var a: int32 = 10
    var b: int32 = 20
    var c = math.sum(a, b)
    var d = math.fact(5)
    var e = (a + b) * c - d

    # if / else
    if e > 0 
    begin
        var r = math.sum(e, 1)
    else 
    begin
        var r = math.sum(0, 1)
    end

    # when
    when
        e == 0 -> begin
            var z: int32 = 0
        end
        e == 10 -> begin
            var z: int32 = 10
        end
        else -> begin
            var z: int32 = 99
        end
    end

    # for + break
    var i: int32 = 0
    for i = 0:10 
    begin
        if i == 5 
        begin
            break
        end
        var t = math.sum(i, 1)
    end

    # while + continue
    while a > 0 
    begin
        a = a - 1
        if a == 5 
        begin
            continue
        end
    end

    # тернарный оператор
    var m = math.max(c, d)
    var flag = m > 0 ? true : false

    # битовые операции
    var bits: int32 = 0
    var mask: int32 = 15
    bits = bits | mask
    bits = bits & 7
    bits = bits ^ 3
    bits = bits << 1
    bits = bits >> 1
    bits = ~bits

    # каст
    var f: float64 = 3.14
    var fi = f::int32
    var ix: int32 = 42
    var fx = ix::float64

    # опциональные типы
    var opt: int32? = none
    opt = 42
    opt = none

    # указатели — базовые операции
    var px: int32 = 100
    var ptr: int32* = &px
    var deref_val = *ptr
    *ptr = 200

    # указатель none
    var null_ptr: int32* = none

    # арифметика указателей
    var arr_val: int32 = 5
    var arr_ptr: int32* = &arr_val
    var shifted = *(arr_ptr + 0)

    # swap через указатели
    var p: int32 = 3
    var q: int32 = 7
    swap(&p, &q)

    # глобальный указатель
    global_ptr = &px
    var from_global = *global_ptr

    # вложенный if
    if c > 0
    begin
        if d > 0
        begin
            var nested = math.sum(c, d)
        else
        begin
            var nested: int32 = 0
        end
    else
    begin
        var nested: int32 = -1
    end

    # вложенный while
    var outer: int32 = 3
    while outer > 0
    begin
        var inner: int32 = 3
        while inner > 0
        begin
            inner = inner - 1
        end
        outer = outer - 1
    end

    # for с шагом
    for i = 0:20:2
    begin
        var stepped = math.sum(i, 0)
    end

    # abs и max
    var neg: int32 = -5
    var abs_result = math.abs_val(neg)
    var max_result = math.max(abs_result, d)

    # составные присваивания
    var comp: int32 = 10
    comp += 5
    comp -= 3
    comp *= 2
    comp /= 4
    comp %= 3

    # const переменная
    var const PI: float64 = 3.14159

    return 0
end